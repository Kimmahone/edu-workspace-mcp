{
  "name": "edu-workspace-mcp",
  "version": "0.1.0",
  "description": "Google Workspace for Education MCP server",
  "license": "MIT",
  "type": "module",
  "bin": {
    "edu-workspace-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:mcp": "npm run build && tsx src/tests/mcp-smoke.ts",
    "prepack": "npm run check && npm test"
  },
  "publishConfig": { "access": "public" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "google-auth-library": "^10.9.1",
    "googleapis": "^176.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
