{
  "name": "edu-workspace-mcp",
  "version": "1.1.0",
  "description": "교육자를 위한 Google Docs, Sheets, Slides, Forms, Drive 및 Classroom MCP 서버",
  "license": "MIT",
  "type": "module",
  "bin": {
    "edu-workspace-mcp": "dist/cli.js"
  },
  "keywords": [
    "mcp",
    "google-workspace",
    "google-classroom",
    "education",
    "teacher"
  ],
  "homepage": "https://edu.jeld.kr/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kimmahone/edu-workspace-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Kimmahone/edu-workspace-mcp/issues"
  },
  "files": [
    "dist",
    "data/curriculum",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "web",
    "docs/WEB_APP_OPERATIONS.md",
    ".env.example",
    "docs/WORKSPACE_LAB_START.md",
    "docs/ASSETS.md",
    "docs/RESULT_QUALITY.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "curriculum:build": "node scripts/build-curriculum-data.mjs && node scripts/build-learning-map.mjs",
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:mcp": "npm run build && tsx src/tests/mcp-smoke.ts",
    "test:e2e": "npm run build && node scripts/e2e-google.mjs",
    "version:check": "node scripts/check-version.mjs",
    "release:check": "npm run version:check && npm run check && npm test && npm run test:mcp && npm audit --omit=dev && npm pack --dry-run",
    "prepack": "npm run version:check && npm run check && npm test",
    "web:dev": "npm run build && node --env-file-if-exists=.env dist/web/main.js",
    "web:start": "node --env-file-if-exists=.env dist/web/main.js",
    "test:web": "npm run build && node --test --import tsx src/tests/web.test.ts",
    "test:web:ui": "npm run build && playwright test",
    "web:examples": "npm run build && node scripts/build-web-examples.mjs && node scripts/render-web-examples.mjs && node scripts/render-form-headers.mjs",
    "web:guide": "node scripts/build-web-guide.mjs",
    "cloud:build": "node scripts/build-cloud.mjs",
    "cloud:types": "wrangler types cloud/worker-configuration.d.ts --config cloud/wrangler.jsonc --strict-vars=false",
    "cloud:check": "npm run cloud:types && tsc -p cloud/tsconfig.json && tsc -p cloud/browser/tsconfig.json",
    "cloud:dev": "npm run cloud:build && wrangler dev --config cloud/wrangler.jsonc --port 3211",
    "cloud:setup": "node scripts/cloud-deploy.mjs --setup",
    "cloud:deploy": "node scripts/cloud-deploy.mjs",
    "test:cloud": "node --import tsx --test cloud/worker.test.ts",
    "test:cloud:browser": "node scripts/test-cloud-browser.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "google-auth-library": "10.9.1",
    "googleapis": "178.0.0",
    "kordoc": "4.15.4",
    "markdown-it": "^15.0.2",
    "pg": "^8.23.0",
    "sanitize-html": "^2.17.7",
    "zod": "3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "22.20.1",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.1",
    "assert": "^2.1.0",
    "browserify-cipher": "^1.0.1",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "create-hash": "^1.2.0",
    "esbuild": "^0.28.2",
    "events": "^3.3.0",
    "korean-elementary-learning-map-mcp": "0.5.1",
    "miniflare": "^5.20260925.0-alpha",
    "path-browserify": "^1.0.1",
    "pbkdf2": "^3.1.6",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "util": "^0.12.5",
    "wrangler": "^4.141.0"
  }
}
