# 개인용: cp .env.example .env 후 Gemini 키를 입력하세요.
APP_MODE=local
PORT=3210
APP_ORIGIN=http://127.0.0.1:3210
GEMINI_API_KEY=
# Google이 갱신하는 Flash 최신 별칭. 무료 전용은 결제 미연결 Free Tier 프로젝트의 키 사용.
GEMINI_MODEL=gemini-flash-latest
# 선택 기능. GPT 개선 버튼을 사용할 때만 호출합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
AI_DAILY_LIMIT=20
APP_OPERATOR=Workspace Lab 운영자
APP_SUPPORT_EMAIL=

# 배포 모드에서 필수. 아래 주석을 해제하고 실제 값으로 설정하세요.
# APP_MODE=hosted
# APP_ORIGIN=https://your-app.example
# APP_SECRET=랜덤한_32자_이상_암호화키
# DATABASE_URL=postgresql://user:password@host:5432/edu?sslmode=require
# GOOGLE_WEB_CLIENT_ID=your-web-client.apps.googleusercontent.com
# GOOGLE_WEB_CLIENT_SECRET=your-web-client-secret
# ALLOWED_EMAILS=teacher1@example.com,teacher2@example.com
# ALLOWED_EMAILS가 비어 있으면 로그인 가능한 모든 Google 계정을 허용합니다.

# 선택: 현재 Google 계정과 앱이 복사할 권한이 있는 Forms 디자인 원본 ID
GOOGLE_FORMS_TEMPLATE_ID=
